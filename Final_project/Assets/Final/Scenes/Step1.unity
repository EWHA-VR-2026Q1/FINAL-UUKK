  m_Script: {fileID: 11500000, guid: 4c08eb5e4e333d94eb8c0b3d95e50838, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 1314093291}
  dialoguePanel: {fileID: 939799330}
  dialogues:
  - "\uC548\uB155! \uB9CC\uB098\uC11C \uBC18\uAC00\uC6CC\uC694."
  - "\uC2DC\uC791\uD558\uAE30 \uC804\uC5D0 \uC6B0\uB9AC\uC5D0 \uB300\uD574 \uC870\uAE08
    \uC54C\uB824\uB4DC\uB9B4\uAC8C\uC694."
  - "\uC6B0\uB9AC\uB791 \uAC19\uC774 \uC0B4\uC544\uAC00\uB824\uBA74,"
  - "\uC801\uB2F9\uD55C \uC0AC\uC721\uC7A5\uC774 \uD544\uC694\uD574\uC694!"
  - "\uC801\uC808\uD55C \uC2B5\uB3C4\uC758 \uBC14\uB2E5\uC7AC\uC640"
  - "\uC548\uC815\uAC10\uC744 \uB290\uB084 \uC218 \uC788\uB3C4\uB85D \uAD6C\uC870\uBB3C\uB3C4\uC694!"
  - "\uBB3C\uB860, \uBA39\uC774\uB97C \uC8FC\uC2DC\uB294 \uAC83\uB3C4 \uC78A\uC73C\uC2DC\uBA74
    \uC548 \uB3FC\uC694."
  - "\uC65C \uC774\uB7F0 \uB9D0\uC744 \uAEBC\uB0C8\uB0D0\uBA74\uC694, \uC774\uAC8C
    \uBBF8\uC158\uC774\uAC70\uB4E0\uC694!"
  - "\uD55C \uBC88 \uC9C1\uC811 \uD574\uBCF4\uC2DC\uACA0\uC5B4\uC694?"
  - "\uC900\uBE44\uAC00 \uB418\uC5C8\uB2E4\uBA74 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694!"
  nextStage: 2
  typingSpeed: 0.05
